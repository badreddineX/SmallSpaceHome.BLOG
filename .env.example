# ─────────────────────────────────────────────────────────────
# Newsletter API — set these in the Vercel project (Settings → Environment
# Variables) for Production + Preview. Copy to .env.local for `astro dev` /
# `vercel dev` local testing (.env.local is git-ignored).
# ─────────────────────────────────────────────────────────────

# Neon Postgres — the POOLED connection string (host contains "-pooler").
# Neon dashboard → your project → Connection Details → "Pooled connection".
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Public site origin — used to build confirm / unsubscribe links in emails.
SITE_URL="https://smallspacehome.ca"

# Hostinger mailbox used to SEND the transactional emails (confirm / welcome).
# This is the professional email you already have for the CAD blog.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="newsletter@smallspacehome.ca"
SMTP_PASS="the-mailbox-password"

# From / Reply-To shown to subscribers.
NEWSLETTER_FROM="SmallSpace Home <newsletter@smallspacehome.ca>"
NEWSLETTER_REPLY_TO="hello@smallspacehome.ca"

# Optional — a physical mailing address shown in the email footer. CASL/CAN-SPAM
# require one for bulk mail; leave unset for now, add before the list scales.
# MAILING_ADDRESS="SmallSpace Home, 123 Example St, City, Country"

# ── Weekly digest (api/broadcast.js + Vercel Cron) ──────────────────
# Resend API key (resend.com → API Keys). Bulk send only; transactional
# stays on Hostinger SMTP above.
RESEND_API_KEY="re_xxxxxxxxxxxx"

# Verified Resend sending identity. Use a subdomain so it never touches the
# working hello@ mailbox setup (add send.smallspacehome.ca in Resend, paste
# its DNS records into Hostinger).
NEWSLETTER_BULK_FROM="SmallSpace Home <hello@send.smallspacehome.ca>"

# Protects /api/broadcast. Vercel Cron sends this automatically as
# `Authorization: Bearer <CRON_SECRET>`. Generate a long random string.
CRON_SECRET="long-random-string"

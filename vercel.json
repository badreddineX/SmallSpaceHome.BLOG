{
  "trailingSlash": false,
  "crons": [
    { "path": "/api/broadcast", "schedule": "0 13 */2 * *" }
  ],
  "redirects": [
    { "source": "/blog/storage-solutions-for-small-apartments", "destination": "/blog/storage-ideas-for-small-places", "permanent": true },
    { "source": "/blog/small-space-decorating", "destination": "/blog/small-space-living-room-ideas", "permanent": true },
    { "source": "/blog/how-to-decorate-a-small-living-room", "destination": "/blog/small-space-living-room-ideas", "permanent": true },
    { "source": "/blog/how-to-make-a-small-room-look-bigger", "destination": "/blog/small-space-living-room-ideas", "permanent": true },
    { "source": "/blog/studio-apartment-ideas", "destination": "/blog/small-space-furniture", "permanent": true },
    { "source": "/blog/multifunctional-furniture-small-apartment", "destination": "/blog/small-space-furniture", "permanent": true },
    { "source": "/blog/budget-apartment-decor-under-100", "destination": "/blog/apartment-decor-ideas-on-a-budget", "permanent": true },
    { "source": "/blog/how-to-organize-studio-apartment", "destination": "/blog/small-apartment-organization", "permanent": true },
    { "source": "/blog/ikea-kallax-hacks-small-spaces", "destination": "/blog/ikea-small-space-hacks", "permanent": true },
    { "source": "/blog/small-apartment-organization-ideas-budget", "destination": "/blog/small-apartment-organization", "permanent": true },
    { "source": "/blog/small-apartment-storage-ideas-canada", "destination": "/blog/storage-ideas-for-small-places", "permanent": true },
    { "source": "/blog/small-bedroom-storage-ideas", "destination": "/blog/small-bedroom-organization-ideas", "permanent": true },
    { "source": "/blog/renter-friendly-apartment-decor-ideas", "destination": "/blog/apartment-decor-ideas", "permanent": true },
    { "source": "/blog/cheapest-ways-rental-feel-stylish", "destination": "/blog/apartment-decor-ideas-on-a-budget", "permanent": true },
    { "source": "/blog/free-cheap-apartment-decor-diy-vs-buy", "destination": "/blog/apartment-decor-ideas-on-a-budget", "permanent": true },
    { "source": "/blog/small-apartment-organization-ideas-on-a-budget", "destination": "/blog/small-apartment-organization", "permanent": true },
    { "source": "/blog/small-apartment-pantry-organization-budget", "destination": "/blog/fridge-pantry-organization-small-apartment", "permanent": true },
    { "source": "/blog/budget-apartment-decor-under-50", "destination": "/blog/apartment-decor-ideas-on-a-budget", "permanent": true }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.clarity.ms https://*.clarity.ms; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://*.clarity.ms https://vitals.vercel-insights.com; img-src 'self' data: https://www.google-analytics.com https://*.clarity.ms; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-src https://www.googletagmanager.com; base-uri 'self'; form-action 'self'" }
      ]
    }
  ]
}

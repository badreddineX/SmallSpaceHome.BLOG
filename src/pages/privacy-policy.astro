---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO
      title="Privacy Policy — SmallSpace Home"
      description="Privacy Policy for SmallSpaceHome.ca — how we collect, use, and protect your information."
      path="/privacy-policy"
      type="website"
    />
  </head>
  <body>
    <Header />

    <main class="legal-page">
      <div class="legal-container">
        <span class="eyebrow legal-eyebrow">SmallSpace Home</span>
        <h1>Privacy Policy</h1>
        <p class="legal-date">Last updated: June 25, 2026</p>
        <hr class="legal-rule" />

        <div class="legal-summary">
          <p class="legal-summary-label">In plain English</p>
          <ul>
            <li>You can read every article on this site without creating an account or handing over personal information.</li>
            <li>We collect basic, anonymous traffic data (via Vercel Analytics) to understand which posts are useful — never sold, never shared with advertisers.</li>
            <li>If you email us, we keep your address only to reply. Nothing more.</li>
            <li>No cookies, no affiliate links, no ad networks, no third-party trackers of any kind.</li>
          </ul>
        </div>

        <p>SmallSpaceHome.ca ("we", "us", or "our") is committed to protecting your privacy. This Privacy Policy explains, in full, how we collect, use, and safeguard information when you visit our website.</p>

        <h2>Information We Collect</h2>
        <p>We don't ask you to create an account or hand over personal information to read our content. The only information we collect is:</p>
        <ul>
          <li><strong>Analytics data</strong> — page views, time on site, and general geographic region, collected anonymously through Vercel Analytics (which uses no cookies or persistent identifiers)</li>
          <li><strong>Contact information</strong> — if you email us directly, we keep your address so we can reply</li>
        </ul>

        <h2>How We Use Your Information</h2>
        <p>We use the information above for three things, and nothing beyond them:</p>
        <ul>
          <li>Understanding which content is genuinely useful to our readers</li>
          <li>Improving the site and the reading experience</li>
          <li>Replying to messages and inquiries you send us</li>
        </ul>

        <h2>Third-Party Services</h2>
        <p>We keep our third-party footprint small. The only service we rely on is:</p>
        <ul>
          <li><strong>Vercel</strong> — website hosting, delivery, and privacy-friendly analytics</li>
        </ul>
        <p>Vercel has its own privacy policy governing how it processes this data on our behalf.</p>

        <h2>Cookies</h2>
        <p>This site does not use cookies. Our analytics provider, Vercel Analytics, measures traffic without cookies, without persistent identifiers, and without tracking you across other websites — there's nothing here to consent to.</p>

        <h2>Children's Privacy</h2>
        <p>This site is not directed at children under 13, and we do not knowingly collect personal information from them.</p>

        <h2>Your Rights (Canada)</h2>
        <p>Under Canadian privacy law (PIPEDA), you have the right to access, correct, or request deletion of any personal information we hold about you. To exercise any of these rights, reach out using the contact details below.</p>

        <h2>Changes to This Policy</h2>
        <p>If this policy changes in a meaningful way, we'll update the date at the top of this page. We encourage you to check back occasionally.</p>

        <h2>Contact</h2>
        <p>Questions about this Privacy Policy? Reach us at <a href="mailto:hello@smallspacehome.ca">hello@smallspacehome.ca</a> — we read and respond to every message personally.</p>
      </div>
    </main>

    <Footer />
  </body>
</html>

<style>
.legal-page {
  padding: 72px 24px 100px;
  background: var(--color-bg);
}
.legal-container {
  max-width: 720px;
  margin: 0 auto;
}
.legal-eyebrow {
  color: var(--color-accent-dark);
  margin-bottom: 16px;
}
.legal-container h1 {
  font-family: var(--font-display);
  font-size: clamp(1.9rem, 4vw, 2.8rem);
  font-weight: 400;
  line-height: 1.1;
  margin-bottom: 10px;
}
.legal-date {
  font-size: 0.82rem;
  color: var(--color-text-faint);
  margin-bottom: 0;
}
.legal-rule {
  width: 100%;
  height: 1px;
  background: var(--color-border);
  border: none;
  margin: 32px 0 40px;
}
.legal-container h2 {
  font-size: 1.1rem;
  font-weight: 600;
  margin-top: 2.4rem;
  margin-bottom: 0.8rem;
}
.legal-container p, .legal-container li {
  font-size: 0.95rem;
  line-height: 1.85;
  color: var(--color-text);
  margin-bottom: 1rem;
}
.legal-container ul {
  padding-left: 1.4rem;
}
.legal-container a {
  color: var(--color-accent-dark);
  text-decoration: underline;
  text-underline-offset: 3px;
}
.legal-summary {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: 6px;
  padding: 24px 28px;
  margin-bottom: 40px;
}
.legal-summary-label {
  font-family: var(--font-body);
  font-size: 0.62rem;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-accent-dark);
  margin-bottom: 14px !important;
}
.legal-summary ul {
  margin: 0;
  padding-left: 1.2rem;
}
.legal-summary li {
  font-size: 0.9rem;
  margin-bottom: 0.6rem;
}
.legal-summary li:last-child { margin-bottom: 0; }
</style>

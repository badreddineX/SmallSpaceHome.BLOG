---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection('blog');
const others   = allPosts.filter(p => p.id !== post.id);

// Score each post by relevance: same category = 3 pts, each shared tag = 1 pt
function score(candidate: typeof post) {
  let s = candidate.data.category === post.data.category ? 3 : 0;
  const postTags = new Set(post.data.tags ?? []);
  for (const t of (candidate.data.tags ?? [])) {
    if (postTags.has(t)) s += 1;
  }
  return s;
}

// Editorial override: relatedPosts frontmatter (slugs) takes priority over the
// auto-scored fallback below, since category+tag scoring can't know about
// cannibalization decisions or intentional hub/spoke relationships from the
// content map. Falls through to auto-scoring for any article that hasn't set it.
let related: typeof others = [];
const explicitSlugs = post.data.relatedPosts ?? [];
if (explicitSlugs.length > 0) {
  const byId = new Map(others.map(p => [p.id, p]));
  related = explicitSlugs
    .map(slug => byId.get(slug))
    .filter((p): p is typeof others[number] => p !== undefined)
    .slice(0, 3);
}

if (related.length < 3) {
  const existingIds = new Set(related.map(p => p.id));
  const scored = others
    .filter(p => !existingIds.has(p.id))
    .map(p => ({ post: p, score: score(p) }))
    .filter(x => x.score > 0)
    .sort((a, b) => b.score - a.score || new Date(b.post.data.datePublished).getTime() - new Date(a.post.data.datePublished).getTime())
    .map(x => x.post);
  related.push(...scored.slice(0, 3 - related.length));
}

// If still fewer than 3, fill with newest posts from same category
if (related.length < 3) {
  const existing = new Set(related.map(p => p.id));
  const fillers = others
    .filter(p => p.data.category === post.data.category && !existing.has(p.id))
    .sort((a, b) => new Date(b.data.datePublished).getTime() - new Date(a.data.datePublished).getTime());
  related.push(...fillers.slice(0, 3 - related.length));
}
---

<BlogPost
  title={post.data.title}
  description={post.data.description}
  slug={post.id}
  image={post.data.image}
  datePublished={post.data.datePublished}
  dateModified={post.data.dateModified}
  author={post.data.author}
  category={post.data.category}
  readTime={post.data.readTime}
  tags={post.data.tags}
  faqs={post.data.faqs ?? []}
  related={related}
>
  <Content />
</BlogPost>

---
import Analytics from '@vercel/analytics/astro';

const siteUrl = 'https://smallspacehome.ca';

const websiteJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "SmallSpace Home",
  "url": siteUrl,
  "inLanguage": "en-CA",
});

const organizationJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteUrl}/#organization`,
  "name": "SmallSpace Home",
  "url": siteUrl,
  "logo": `${siteUrl}/images/logo.png`,
  "sameAs": [
    "https://www.facebook.com/people/SmallSpace-Home/61592431767425/",
    "https://www.instagram.com/smallspace_home/",
    "https://www.pinterest.com/SmallSpaceHomecad/",
  ],
});
---

<script type="application/ld+json" set:html={websiteJsonLd} />
<script type="application/ld+json" set:html={organizationJsonLd} />

<footer class="site-footer">

  <!-- Newsletter band -->
  <div class="footer-nl-band">
    <div class="container footer-nl-inner">
      <div class="footer-nl-copy">
        <p class="footer-nl-eyebrow">The SmallSpace Newsletter</p>
        <p class="footer-nl-head">One small-space idea a week — with real CAD prices.</p>
        <p class="footer-nl-sub">Renter-friendly fixes, no spam, unsubscribe anytime.</p>
      </div>
      <form class="nl-form footer-nl-form" method="POST" action="/api/subscribe" novalidate>
        <input type="hidden" name="source" value="footer" />
        <span class="footer-nl-hp" aria-hidden="true">
          <label>Leave empty<input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
        </span>
        <label class="sr-only" for="footer-nl-email">Email address</label>
        <div class="footer-nl-row">
          <input
            class="footer-nl-input"
            type="email"
            id="footer-nl-email"
            name="email"
            placeholder="you@email.com"
            autocomplete="email"
            inputmode="email"
            required
          />
          <button type="submit" class="footer-nl-btn">Subscribe</button>
        </div>
        <p class="nl-status footer-nl-status" role="status" aria-live="polite" hidden></p>
        <p class="footer-nl-fine">
          By subscribing you agree to receive the weekly email. See our
          <a href="/privacy-policy">Privacy Policy</a>.
        </p>
      </form>
    </div>
  </div>

  <!-- Top band -->
  <div class="footer-top">
    <div class="container footer-top-inner">
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="SmallSpace Home — homepage">
          <span class="footer-logo-img-wrap">
            <img
              src="/images/logo.png"
              alt=""
              class="footer-logo-img"
              width="120"
              height="40"
              aria-hidden="true"
            />
          </span>
          <span class="footer-logo-text">SmallSpace Home</span>
        </a>
        <p class="footer-tagline">
          Organization and decor ideas for Canadian apartment renters.
          Renter-friendly. Budget-conscious. Actually useful.
        </p>

        <!-- Social media icons -->
        <div class="footer-social" aria-label="Follow us on social media">
          <a href="https://www.facebook.com/people/SmallSpace-Home/61592431767425/" class="social-link" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>

          <a href="https://www.instagram.com/smallspace_home/" class="social-link" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/>
            </svg>
          </a>

          <a href="https://www.pinterest.com/SmallSpaceHomecad/" class="social-link" target="_blank" rel="noopener noreferrer" aria-label="Pinterest">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/>
            </svg>
          </a>
        </div>
      </div>

      <nav class="footer-nav" aria-label="Footer navigation">
        <div class="footer-col">
          <span class="footer-col-label">Read</span>
          <a href="/blog">All Posts</a>
          <a href="/blog/category/organization">Organization</a>
          <a href="/blog/category/decor">Decor</a>
          <a href="/blog/category/storage">Storage</a>
          <a href="/blog/category/budget-tips">Budget Tips</a>
        </div>
        <div class="footer-col">
          <span class="footer-col-label">Site</span>
          <a href="/about">About</a>
          <a href="/author">Author</a>
          <a href="/contact">Contact</a>
          <a href="/editorial-policy">Editorial Policy</a>
          <a href="/privacy-policy">Privacy Policy</a>
          <a href="/terms">Terms of Use</a>
        </div>
      </nav>
    </div>
  </div>


</footer>

<style>
.site-footer {
  background: var(--color-dark);
  margin-top: 0;
}

/* ── Newsletter band ── */
.footer-nl-band {
  background: #262019;
  border-bottom: 1px solid rgba(255,255,255,0.06);
  padding: 40px 0;
}
.footer-nl-inner {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 48px;
}
.footer-nl-copy { flex: 1 1 300px; }
.footer-nl-eyebrow {
  font-size: 0.6rem;
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-accent);
  margin: 0 0 10px;
}
.footer-nl-head {
  font-family: var(--font-display);
  font-style: italic;
  font-size: 1.15rem;
  line-height: 1.35;
  color: rgba(255,255,255,0.92);
  margin: 0 0 6px;
}
.footer-nl-sub {
  font-size: 0.82rem;
  color: rgba(255,255,255,0.45);
  margin: 0;
  font-weight: 300;
}
.footer-nl-form { flex: 1 1 360px; max-width: 420px; margin: 0; }
.footer-nl-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
.footer-nl-row { display: flex; gap: 10px; flex-wrap: wrap; }
.footer-nl-input {
  flex: 1 1 200px;
  min-width: 0;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.16);
  border-radius: 0;
  padding: 12px 14px;
  font-family: var(--font-body);
  font-size: 16px;
  color: #fff;
  outline: none;
  transition: border-color var(--transition), background var(--transition);
  -webkit-appearance: none;
  appearance: none;
}
.footer-nl-input::placeholder { color: rgba(255,255,255,0.4); }
.footer-nl-input:focus { border-color: var(--color-accent); background: rgba(255,255,255,0.09); }
.footer-nl-input[aria-invalid='true'] { border-color: #E0997F; }
.footer-nl-btn {
  flex: 0 0 auto;
  min-height: 46px;
  padding: 12px 24px;
  background: var(--color-accent-dark);
  color: #fff;
  border: 1.5px solid var(--color-accent-dark);
  font-family: var(--font-body);
  font-size: 0.68rem;
  font-weight: 500;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  cursor: pointer;
  transition: background var(--transition), border-color var(--transition);
  -webkit-tap-highlight-color: transparent;
}
.footer-nl-btn:hover { background: #7a6040; border-color: #7a6040; }
.footer-nl-btn:disabled { opacity: 0.6; cursor: default; }
.footer-nl-status {
  margin: 12px 0 0;
  font-size: 0.82rem;
  line-height: 1.55;
  padding: 9px 12px;
  background: rgba(255,255,255,0.05);
  border-left: 3px solid rgba(255,255,255,0.2);
  color: rgba(255,255,255,0.8);
}
.footer-nl-status.nl-status--ok  { border-left-color: var(--color-primary); }
.footer-nl-status.nl-status--err { border-left-color: #E0997F; color: #F0C4B6; }
.footer-nl-fine {
  margin: 12px 0 0;
  font-size: 0.68rem;
  line-height: 1.6;
  color: rgba(255,255,255,0.35);
}
.footer-nl-fine a { color: rgba(255,255,255,0.6); text-decoration: underline; text-underline-offset: 2px; }
.footer-nl-fine a:hover { color: #fff; }

.sr-only {
  position: absolute;
  width: 1px; height: 1px;
  padding: 0; margin: -1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}

@media (max-width: 860px) {
  .footer-nl-inner { flex-direction: column; gap: 24px; }
  .footer-nl-form { max-width: 100%; width: 100%; }
}
@media (max-width: 480px) {
  .footer-nl-row { flex-direction: column; }
  .footer-nl-btn { width: 100%; }
}

/* ── Top ── */
.footer-top {
  padding: 72px 0 64px;
}

.footer-top-inner {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 64px;
}

.footer-logo {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 18px;
  text-decoration: none;
  transition: opacity var(--transition);
}
.footer-logo:hover { opacity: 0.8; }

.footer-logo-img-wrap {
  display: flex;
  align-items: center;
  background: #FAFAF7;
  padding: 3px 6px;
  border-radius: 2px;
  flex-shrink: 0;
}
.footer-logo-img {
  height: 44px;
  width: auto;
  display: block;
  object-fit: contain;
}
.footer-logo-text {
  font-family: var(--font-body);
  font-weight: 300;
  font-size: 0.68rem;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.82);
  white-space: nowrap;
}

.footer-tagline {
  font-size: 0.85rem;
  color: rgba(255,255,255,0.4);
  max-width: 260px;
  line-height: 1.75;
  font-weight: 300;
  margin: 0 0 24px;
}

/* ── Social icons ── */
.footer-social {
  display: flex;
  align-items: center;
  gap: 12px;
}

.social-link {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 50%;
  color: rgba(255,255,255,0.5);
  text-decoration: none;
  transition: border-color var(--transition), color var(--transition), background var(--transition);
  -webkit-tap-highlight-color: transparent;
  flex-shrink: 0;
}
.social-link:hover {
  border-color: var(--color-accent);
  color: var(--color-accent);
  background: rgba(196,168,130,0.08);
}

/* Facebook blue on hover */
.social-link[aria-label^="Facebook"]:hover {
  border-color: #1877F2;
  color: #1877F2;
  background: rgba(24,119,242,0.06);
}
/* Instagram pink on hover */
.social-link[aria-label^="Instagram"]:hover {
  border-color: #E1306C;
  color: #E1306C;
  background: rgba(225,48,108,0.06);
}
/* Pinterest red on hover */
.social-link[aria-label^="Pinterest"]:hover {
  border-color: #E60023;
  color: #E60023;
  background: rgba(230,0,35,0.06);
}
.footer-nav {
  display: flex;
  gap: 64px;
  flex-shrink: 0;
}

.footer-col {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.footer-col-label {
  font-size: 0.62rem;
  font-weight: 500;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-accent);
  margin-bottom: 4px;
}

.footer-col a {
  font-size: 0.88rem;
  color: rgba(255,255,255,0.5);
  text-decoration: none;
  font-weight: 300;
  transition: color var(--transition);
}
.footer-col a:hover { color: rgba(255,255,255,0.9); }

@media (max-width: 768px) {
  .footer-top-inner    { flex-direction: column; gap: 40px; }
  .footer-tagline      { max-width: 100%; }
}
</style>

<Analytics />

<!-- ── Cookie Consent Banner ── -->
<div class="cookie-banner" id="cookie-banner" aria-live="polite" aria-label="Cookie consent">
  <p class="cookie-text">
    We use cookies to improve your experience. By continuing to browse, you agree to our <a href="/privacy-policy" class="cookie-link">Privacy Policy</a>.
  </p>
  <div class="cookie-actions">
    <button class="cookie-btn cookie-accept" id="cookie-accept">Accept</button>
    <button class="cookie-btn cookie-decline" id="cookie-decline">Decline</button>
  </div>
</div>

<style>
.cookie-banner {
  position: fixed;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 9999;
  background: var(--color-dark);
  color: rgba(255,255,255,0.88);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 6px;
  padding: 16px 20px;
  display: flex;
  align-items: center;
  gap: 20px;
  flex-wrap: wrap;
  width: calc(100% - 32px);
  max-width: 680px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.28);
  animation: cookie-slide-up 0.3s ease both;
}

.cookie-banner.hidden {
  display: none;
}

@keyframes cookie-slide-up {
  from { opacity: 0; transform: translateX(-50%) translateY(16px); }
  to   { opacity: 1; transform: translateX(-50%) translateY(0); }
}

.cookie-text {
  flex: 1;
  font-size: 0.82rem;
  line-height: 1.6;
  color: rgba(255,255,255,0.75);
  margin: 0;
  min-width: 200px;
}

.cookie-link {
  color: var(--color-accent);
  text-decoration: underline;
  text-underline-offset: 2px;
}
.cookie-link:hover { color: #fff; }

.cookie-actions {
  display: flex;
  gap: 8px;
  flex-shrink: 0;
}

.cookie-btn {
  border: none;
  border-radius: 3px;
  padding: 8px 18px;
  font-family: inherit;
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  cursor: pointer;
  transition: background 0.18s ease, color 0.18s ease;
  white-space: nowrap;
  -webkit-tap-highlight-color: transparent;
}

.cookie-accept {
  background: var(--color-accent-dark);
  color: #fff;
}
.cookie-accept:hover { background: #7a6040; }

.cookie-decline {
  background: rgba(255,255,255,0.08);
  color: rgba(255,255,255,0.6);
  border: 1px solid rgba(255,255,255,0.15);
}
.cookie-decline:hover { background: rgba(255,255,255,0.14); color: #fff; }

@media (max-width: 480px) {
  .cookie-banner { bottom: 16px; padding: 14px 16px; gap: 12px; }
  .cookie-text   { font-size: 0.78rem; }
}
</style>

<script>
(function () {
  const banner = document.getElementById('cookie-banner');
  if (!banner) return;

  // Persisted in localStorage — once the visitor answers, it never
  // reappears on refresh or on later visits from the same browser.
  if (localStorage.getItem('cookie-consent')) {
    banner.classList.add('hidden');
    return;
  }

  document.getElementById('cookie-accept')?.addEventListener('click', () => {
    localStorage.setItem('cookie-consent', 'accepted');
    banner.classList.add('hidden');
    // Actually start analytics now -- these were gated in SEO.astro and
    // never loaded at all until this moment.
    if (typeof window.gtag === 'function') {
      window.gtag('consent', 'update', {
        analytics_storage: 'granted',
        ad_storage: 'granted',
        ad_user_data: 'granted',
        ad_personalization: 'granted',
      });
    }
    window.__startAnalytics?.();
    window.__startClarity?.();
  });

  document.getElementById('cookie-decline')?.addEventListener('click', () => {
    localStorage.setItem('cookie-consent', 'declined');
    banner.classList.add('hidden');
    // Nothing to do here -- analytics/Clarity were never loaded, and stay
    // that way (Consent Mode default in SEO.astro is already 'denied').
  });
})();
</script>

<!-- ── Newsletter signup — progressive enhancement for every .nl-form on the page ── -->
<script>
(function () {
  const forms = document.querySelectorAll('form.nl-form');
  if (!forms.length) return;

  const MSG: Record<string, string> = {
    pending: 'Almost there — check your inbox and click the confirmation link.',
    already_subscribed: "You're already on the list. Thanks!",
    invalid_email: 'Please enter a valid email address.',
    error: 'Something went wrong. Please try again in a moment.',
    network: 'Network error — please try again.',
  };

  forms.forEach((formEl) => {
    const form = formEl as HTMLFormElement;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      const status = form.querySelector('.nl-status') as HTMLElement | null;
      const email = form.querySelector('input[name="email"]') as HTMLInputElement | null;
      const company = form.querySelector('input[name="company"]') as HTMLInputElement | null;
      const source = form.querySelector('input[name="source"]') as HTMLInputElement | null;

      if (company && company.value) return;           // bot
      if (!email) return;

      if (!email.value || !email.checkValidity()) {
        email.setAttribute('aria-invalid', 'true');
        show(status, MSG.invalid_email, 'err');
        email.focus();
        return;
      }
      email.removeAttribute('aria-invalid');

      const label = btn ? btn.textContent : '';
      if (btn) { btn.disabled = true; btn.textContent = 'Subscribing…'; }

      try {
        const r = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({
            email: email.value,
            source: source ? source.value : 'site',
            company: '',
          }),
        });
        const data = (await r.json().catch(() => ({}))) as { ok?: boolean; state?: string; error?: string };

        if (r.ok && data.ok) {
          show(status, MSG[data.state ?? ''] || MSG.pending, 'ok');
          form.reset();
        } else {
          show(status, MSG[data.error ?? ''] || MSG.error, 'err');
        }
      } catch (err) {
        show(status, MSG.network, 'err');
      } finally {
        if (btn) { btn.disabled = false; btn.textContent = label; }
      }
    });
  });

  function show(el: HTMLElement | null, msg: string, kind: 'ok' | 'err') {
    if (!el) return;
    el.textContent = msg;
    el.hidden = false;
    el.classList.remove('nl-status--ok', 'nl-status--err');
    el.classList.add(kind === 'ok' ? 'nl-status--ok' : 'nl-status--err');
  }
})();
</script>

---
import sharp from 'sharp';
import { join } from 'node:path';
import { readFileSync } from 'node:fs';

// Inlined at build time: /fonts.css is only ~7.7KB but as an external stylesheet
// it render-blocks the whole page for a full network round-trip (Lighthouse
// measured ~1.2s of render-blocking delay, FCP 3.4s / LCP 7.0s). Inlining it
// removes that request from the critical path entirely.
const fontCss = readFileSync(join(process.cwd(), 'public', 'fonts.css'), 'utf8');

interface Props {
  title: string;
  description: string;
  slug?: string;
  path?: string;
  image?: string;
  datePublished?: string;
  dateModified?: string;
  authorName?: string;
  type?: 'website' | 'article';
  faqs?: { q: string; a: string }[];
  noindex?: boolean;
}

const {
  title,
  description,
  slug,
  path,
  image = '/images/about-hero-apartment.jpg',
  datePublished,
  dateModified,
  authorName = 'Badreddine Br',
  type = 'website',
  faqs = [],
  noindex = false,
} = Astro.props;

const siteUrl   = 'https://smallspacehome.ca';
const fullUrl   = slug ? `${siteUrl}/blog/${slug}` : path ? `${siteUrl}${path}` : siteUrl;
const fullImage = image.startsWith('http') ? image : `${siteUrl}${image}`;
const fullTitle = `${title} | SmallSpace Home`;

// Social platforms (Facebook, Pinterest, LinkedIn) crop og:image to the declared
// width/height, not the file's real dimensions -- an undeclared or wrong pair
// causes a bad auto-crop. Read the real file so the declaration is never a lie.
let ogImageWidth: number | null = null;
let ogImageHeight: number | null = null;
if (!image.startsWith('http')) {
  try {
    const imgPath = join(process.cwd(), 'public', image);
    const meta = await sharp(imgPath).metadata();
    ogImageWidth = meta.width ?? null;
    ogImageHeight = meta.height ?? null;
  } catch {
    // Leave null -- platforms fall back to reading the image's own header.
  }
}

const isArticle    = type === 'article';
const hasPublished = isArticle && Boolean(datePublished);
const hasModified  = isArticle && Boolean(dateModified);
const modOrPub     = dateModified || datePublished || '';

const articleJsonLd = isArticle ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "image": fullImage,
  "datePublished": datePublished,
  "dateModified": modOrPub,
  "author": {
    "@type": "Person",
    "@id": `${siteUrl}/about#person`,
    "name": authorName,
    "url": `${siteUrl}/about`
  },
  "publisher": {
    "@type": "Organization",
    "name": "SmallSpace Home",
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/favicon.svg`
    },
    "sameAs": [
      "https://www.facebook.com/people/SmallSpace-Home/61592431767425/",
      "https://www.instagram.com/smallspace_home/",
      "https://www.pinterest.com/SmallSpaceHomecad/",
    ]
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": fullUrl
  }
}) : null;

const breadcrumbJsonLd = isArticle ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": `${siteUrl}/blog` },
    { "@type": "ListItem", "position": 3, "name": title, "item": fullUrl }
  ]
}) : null;

const faqJsonLd = faqs.length > 0 ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a.replace(/<[^>]+>/g, '')
    }
  }))
}) : null;
---

<!-- Google Tag Manager + gtag.js -- injected via JS on the `load` event, not
     `defer`. `defer` only delays *execution*, not the network fetch -- the
     browser starts downloading deferred <script src> tags immediately during
     parsing, so on a throttled/bandwidth-limited connection they competed with
     the hero image and fonts for bandwidth and made LCP/FCP measurably worse
     (verified: LCP 5-6s, FCP 4.4s after switching to defer, vs 2-3s before).
     Injecting on `load` keeps them out of the network queue entirely until
     everything above-the-fold has already finished loading -- no arbitrary
     wall-clock delay added on top (that was the earlier, separate problem),
     just "wait for the load event", which Lighthouse measures consistently. -->
<script is:inline>(function(w,d,s,l,gtmId,gaId){
  function start(){
    w[l]=w[l]||[];w[l].push({'gtm.start': new Date().getTime(),event:'gtm.js'});
    var f=d.getElementsByTagName(s)[0];
    var j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';
    j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+gtmId+dl;
    f.parentNode.insertBefore(j,f);

    var g=d.createElement(s);
    g.async=true;g.src='https://www.googletagmanager.com/gtag/js?id='+gaId;
    f.parentNode.insertBefore(g,f);
    function gtag(){w.dataLayer.push(arguments);}
    w.gtag=gtag;
    gtag('js', new Date());
    gtag('config', gaId);
  }
  if (d.readyState === 'complete') start();
  else w.addEventListener('load', start);
})(window,document,'script','dataLayer','GTM-N5MCBQG6','G-8RQLW4BWHR');</script>
<!-- End Google Tag Manager + gtag.js -->

<!-- Microsoft Clarity, issued via Bing Webmaster Tools account (ref=bwt) -->
<script is:inline>
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i+"?ref=bwt";
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "y0t20hwn7f");
</script>

<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<!-- Self-hosted fonts (was Google Fonts CDN -- removed 2 external DNS/connection
     round-trips from the critical render path). Preload the two weights actually
     used above the fold (hero H1 is Playfair 400, body copy is Inter 400); the
     rest load normally via fonts.css, still font-display:swap. -->
<link rel="preload" as="font" type="font/woff2" href="/fonts/playfair-display-400-normal-latin.woff2" crossorigin />
<link rel="preload" as="font" type="font/woff2" href="/fonts/inter-400-normal-latin.woff2" crossorigin />
<style is:inline set:html={fontCss}></style>

<!-- Primary -->
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'} />
<link rel="canonical" href={fullUrl} />
<link rel="alternate" type="application/rss+xml" title="SmallSpace Home" href="/rss.xml" />
<link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs.txt" />
<meta name="google-site-verification" content="z1oIcfJSzQJnQ5TivxBkr_cdEvA8f3qzg4OQ9BU04kM" />

<!-- Open Graph -->
<meta property="og:type"         content={type} />
<meta property="og:title"        content={fullTitle} />
<meta property="og:description"  content={description} />
<meta property="og:url"          content={fullUrl} />
<meta property="og:image"   content={fullImage} />
{ogImageWidth  && <meta property="og:image:width"  content={String(ogImageWidth)} />}
{ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
<meta property="og:locale"  content="en_CA" />
<meta property="og:site_name"    content="SmallSpace Home" />

<!-- Twitter Card -->
<meta name="twitter:card"        content="summary_large_image" />
<meta name="twitter:title"       content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image"       content={fullImage} />

<!-- Article meta (only rendered when type="article") -->
{hasPublished && <meta property="article:published_time" content={datePublished} />}
{hasModified  && <meta property="article:modified_time"  content={dateModified} />}
{isArticle    && <meta property="article:author"         content={authorName} />}

<!-- Article JSON-LD -->
{isArticle && articleJsonLd && <script type="application/ld+json" set:html={articleJsonLd} />}

<!-- Breadcrumb JSON-LD -->
{isArticle && breadcrumbJsonLd && <script type="application/ld+json" set:html={breadcrumbJsonLd} />}

<!-- FAQ JSON-LD -->
{faqJsonLd && <script type="application/ld+json" set:html={faqJsonLd} />}

<!-- Pinterest domain verification -->
<meta name="p:domain_verify" content="76c1b2d2d3bd74073ee8a940f8b2848a" />

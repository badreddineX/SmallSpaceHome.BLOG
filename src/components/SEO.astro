---
interface Props {
  title: string;
  description: string;
  slug?: string;
  path?: string;
  image?: string;
  datePublished?: string;
  dateModified?: string;
  authorName?: string;
  type?: 'website' | 'article';
  faqs?: { q: string; a: string }[];
  noindex?: boolean;
}

const {
  title,
  description,
  slug,
  path,
  image = '/images/about-hero-apartment.jpg',
  datePublished,
  dateModified,
  authorName = 'Badreddine Br',
  type = 'website',
  faqs = [],
  noindex = false,
} = Astro.props;

const siteUrl   = 'https://smallspacehome.ca';
const fullUrl   = slug ? `${siteUrl}/blog/${slug}` : path ? `${siteUrl}${path}` : siteUrl;
const fullImage = image.startsWith('http') ? image : `${siteUrl}${image}`;
const fullTitle = `${title} | SmallSpace Home`;

const isArticle    = type === 'article';
const hasPublished = isArticle && Boolean(datePublished);
const hasModified  = isArticle && Boolean(dateModified);
const modOrPub     = dateModified || datePublished || '';

const articleJsonLd = isArticle ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "image": fullImage,
  "datePublished": datePublished,
  "dateModified": modOrPub,
  "author": {
    "@type": "Person",
    "name": authorName,
    "url": `${siteUrl}/about`
  },
  "publisher": {
    "@type": "Organization",
    "name": "SmallSpace Home",
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/favicon.svg`
    },
    "sameAs": [
      "https://www.facebook.com/people/SmallSpace-Home/61592431767425/",
      "https://www.instagram.com/smallspace_home/",
      "https://www.pinterest.com/SmallSpaceHomecad/",
    ]
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": fullUrl
  }
}) : null;

const breadcrumbJsonLd = isArticle ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": `${siteUrl}/blog` },
    { "@type": "ListItem", "position": 3, "name": title, "item": fullUrl }
  ]
}) : null;

const faqJsonLd = faqs.length > 0 ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a.replace(/<[^>]+>/g, '')
    }
  }))
}) : null;
---

<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<!-- Font preconnect + async stylesheet (moved out of global.css's @import to break the
     render-blocking fetch chain; preload+swap keeps a plain <link rel=stylesheet> from
     blocking first paint — safe here because font-display=swap already handles the FOUT). -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="preload"
  as="style"
  href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600&display=swap"
  onload="this.onload=null;this.rel='stylesheet'"
/>
<noscript>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600&display=swap" />
</noscript>

<!-- Primary -->
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
<link rel="canonical" href={fullUrl} />
<link rel="alternate" type="application/rss+xml" title="SmallSpace Home" href="/rss.xml" />
<meta name="google-site-verification" content="z1oIcfJSzQJnQ5TivxBkr_cdEvA8f3qzg4OQ9BU04kM" />

<!-- Open Graph -->
<meta property="og:type"         content={type} />
<meta property="og:title"        content={fullTitle} />
<meta property="og:description"  content={description} />
<meta property="og:url"          content={fullUrl} />
<meta property="og:image"   content={fullImage} />
<meta property="og:locale"  content="en_CA" />
<meta property="og:site_name"    content="SmallSpace Home" />

<!-- Twitter Card -->
<meta name="twitter:card"        content="summary_large_image" />
<meta name="twitter:title"       content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image"       content={fullImage} />

<!-- Article meta (only rendered when type="article") -->
{hasPublished && <meta property="article:published_time" content={datePublished} />}
{hasModified  && <meta property="article:modified_time"  content={dateModified} />}
{isArticle    && <meta property="article:author"         content={authorName} />}

<!-- Article JSON-LD -->
{isArticle && articleJsonLd && <script type="application/ld+json" set:html={articleJsonLd} />}

<!-- Breadcrumb JSON-LD -->
{isArticle && breadcrumbJsonLd && <script type="application/ld+json" set:html={breadcrumbJsonLd} />}

<!-- FAQ JSON-LD -->
{faqJsonLd && <script type="application/ld+json" set:html={faqJsonLd} />}

<!-- Pinterest domain verification -->
<meta name="p:domain_verify" content="76c1b2d2d3bd74073ee8a940f8b2848a" />

<!-- Google tag (gtag.js) -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-8RQLW4BWHR"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-8RQLW4BWHR');
</script>

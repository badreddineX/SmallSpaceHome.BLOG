node_modules/
dist/
.env
.env.local
.env*.local
.vercel
.DS_Store

# Astro generated types
.astro/

# Raw image originals kept locally, excluded from deploys
public/images/*/
# ...except generated deploy-required assets:
!public/images/thumb/
!public/images/featured/
!public/images/feat-side/

# WebP siblings of public/images/*.jpg|png -- regenerated at every build by
# the `prebuild` script (scripts/to-webp.mjs), not source, not worth ~32MB
# of committed binaries that go stale the moment a source jpg changes.
public/images/*.webp

# Generated pin/short exports
out/
out-instagram/
out-shorts/
out-profile/
pin-generator/*-demo.json
digital-products/

# Ebook PDFs mirrored here from the digital-products build — not referenced
# by any site source or public/, not served live; kept on disk, not in git
# history (5-14MB each, was driving .git to 448MB)
dig prod/pdf/*.pdf
